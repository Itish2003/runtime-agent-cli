{
  "name": "runtime-agent-cli",
  "version": "0.1.1",
  "description": "A dev-time CLI that reflects your live API for AI coding agents — verify what the server actually does, not what the code assumes.",
  "license": "MIT",
  "author": "Itish Srivastava (https://github.com/Itish2003)",
  "type": "module",
  "keywords": [
    "openapi",
    "swagger",
    "cli",
    "ai-agents",
    "agentic",
    "llm",
    "claude",
    "cursor",
    "api-testing",
    "bun"
  ],
  "homepage": "https://github.com/Itish2003/runtime-agent-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Itish2003/runtime-agent-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Itish2003/runtime-agent-cli/issues"
  },
  "bin": {
    "runtime-agent-cli": "src/cli.ts",
    "rac": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "build": "bun build --compile --minify src/cli.ts --outfile runtime-agent-cli",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@readme/openapi-parser": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "openapi-types": "^12.1.3",
    "typescript": "~6.0.3"
  }
}
