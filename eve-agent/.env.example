# Model: one env var picks the preset (agent/agent.ts):
#   MODEL_PRESET=local     friend's Ollama box, gemma4:12b, free (default)
#   MODEL_PRESET=deepseek  metered API, key from DEEPSEEK_API_KEY
# Any field can still be overridden individually:
#   MODEL_BASE_URL / MODEL_ID / MODEL_API_KEY / MODEL_CONTEXT_TOKENS
MODEL_PRESET=local
# Public base URL this agent is reachable at — used in the A2A agent card.
A2A_BASE_URL=http://localhost:2002
# Where the hand_back tool looks for the PORTFOLIO's agent card. Only the
# base URL is configured — the JSONRPC endpoint itself is read from the card
# at call time, so the portfolio can move its own endpoint without a redeploy
# here. Production: https://portfolio-murex-eight-7tpx3l2quj.vercel.app
PORTFOLIO_BASE_URL=http://localhost:3000
# OpenAPI target the rac demo tool probes. Unset falls back to the petstore
# spec; production points at https://fable20.vercel.app/openapi.json.
RAC_DEMO_TARGET_URL=
